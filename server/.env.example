# Server
PORT=8080
NODE_ENV=development
# Required for signing short-lived access JWTs. Generate at least 32 random bytes.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
EMAIL_TOKEN_SECRET=replace-with-a-different-32-byte-random-secret

# Frontend URL (ваш Vercel URL)
FRONT_ORIGIN=http://localhost:5173
# Public contact for personal-data requests. Replace before production launch.
PRIVACY_EMAIL=[PRIVACY_EMAIL]
# Per-IP/user submissions allowed per hour.
PRIVACY_REQUEST_RATE_LIMIT_MAX=5
# MySQL (если используете Docker)
DB_HOST=mysql
DB_PORT=3306
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=lostfound

# Required while legacy owner-check secrets are in use. Use 64 hex characters.
SECRETS_KEY=replace-with-64-hex-character-key

# S3-compatible Object Storage (Yandex Cloud, AWS S3, MinIO, etc.)
S3_BUCKET=lostfound-uploads
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_PUBLIC_BASE_URL=https://storage.yandexcloud.net/lostfound-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Transactional email provider accepting POST {from,to,subject,html,text}.
# In development, leaving these empty uses a metadata-only log adapter.
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=LostFound <no-reply@example.com>
